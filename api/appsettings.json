{
	"ConnectionStrings": {
		"DefaultConnection": "<Your-DB-Connection-String-Here>"
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"Paging": {
		"MinPage": 1,
		"MinPageSize": 1,
		"MaxPageSize": 100,
		"LimitArgumentName": "limit",
		"MinLimit": 1,
		"MaxLimit": 1000
	}
}
